rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User uploads - users can only upload to their own folder
    match /uploads/{userId}/{allPaths=**} {
      // Users can read their own uploads
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can only upload to their own folder
      allow write: if isAuthenticated() && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max file size
        && request.resource.contentType.matches('image/.*|application/pdf|text/.*');
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
